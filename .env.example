# Local credentials for src/sync_matches.py
# Copy this file to `.env` and fill in the values. `.env` is gitignored.
# CI (GitHub Actions) uses repo secrets instead of this file.

# FootyStats API key
FOOTYSTATS_API_KEY=

# WordPress Application Password (wp-admin > Users > Profile > Application Passwords)
# WP_APP_USERNAME is the account's user_login; WP_APP_PASSWORD is the generated
# string (the spaces in it are fine, leave them as-is, no quotes needed).
WP_APP_USERNAME=
WP_APP_PASSWORD=
